# Normaliza fin de línea a LF en el repositorio y en el working tree
* text=auto eol=lf

# Scripts que se ejecutan en contenedores Linux: siempre LF
*.sh text eol=lf
mvnw text eol=lf
*.template text eol=lf
Dockerfile text eol=lf

# Scripts de Windows
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
