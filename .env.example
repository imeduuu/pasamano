# Copia este archivo a .env y ajusta los valores. NUNCA subas un .env real al repositorio.
# Los valores de ejemplo sirven solo para desarrollo local.

# --- PostgreSQL ---
POSTGRES_DB=trato
POSTGRES_USER=trato
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5432

# --- MinIO (almacenamiento de imágenes, API S3) ---
MINIO_ROOT_USER=trato-minio
MINIO_ROOT_PASSWORD=cambia-esta-clave-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=listings
S3_REGION=us-east-1
S3_URL_EXPIRATION=15m

# --- Mailpit (captura de correos en local) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=Trato <no-responder@trato.localhost>

# --- Backend ---
# Perfiles disponibles: local, demo (logs JSON). El perfil test lo usan solo las pruebas.
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
# Clave HMAC para firmar los JWT: mínimo 32 bytes, aleatoria. Genera una con:
#   openssl rand -base64 48
JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-al-menos-32-bytes
# false para Compose local por HTTP; true en despliegues HTTPS.
REFRESH_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend ---
FRONTEND_PORT=4200
