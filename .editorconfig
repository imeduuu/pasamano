# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
# google-java-format: 2 espacios, 100 columnas
indent_size = 2
max_line_length = 100

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[Makefile]
indent_style = tab
